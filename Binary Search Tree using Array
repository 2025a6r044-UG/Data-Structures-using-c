// Binary search tree using array 
#include<stdio.h>
#include<stdlib.h>
#define max 100
int tree[max];
void initTree(){
    for(int i=0;i<max;i++){
        tree[i] = -1;
    }
}

void insert(int index,int val){     //Here we are inserting data in BT using level order
    if(index == max)
        printf("Cannot insert node!!\n");
    else if(tree[index] == -1){
        tree[index]=val;
    }
    else if(val<tree[index])
        insert(2*index+1,val);
    else
        insert(2*index+2,val);
}

void preOrder(int index){
    if(index >= max || tree[index]== -1)
        return;
    printf("%d ",tree[index]);
    preOrder(2*index+1);
    preOrder(2*index+2);
}

void inOrder(int index){
    if(index >= max || tree[index] == -1)
        return;
    inOrder(2*index+1);
    printf("%d ",tree[index]);
    inOrder(2*index+2);
}

void postOrder(int index){
    if(index >= max || tree[index] == -1)
        return;
    postOrder(2*index+1);
    postOrder(2*index+2);
    printf("%d ",tree[index]);
}

int main(){
    int choice , value;
    initTree();
    while(1){
        printf("\n1.Insert\n");
        printf("2. Pre-Order Transversal\n");
        printf("3. In-Order Transversal\n");
        printf("4. Post-Order Transversal\n");
        printf("5. Exit\n");
        printf("Enter Choice:");
        scanf("%d",&choice);
        switch(choice){
            case 1:
                printf("Enter Value:");
                scanf("%d",&value);
                insert(0,value);
                break;
            case 2:
                preOrder(0);
                break;
            case 3:
                inOrder(0);
                break;
            case 4:
                postOrder(0);
                break;
            case 5:
                exit(0);
                break;
            default:
                printf("Invalid choice!!\n");
                break;
        }
    }
    return 0;
}
