void insertAtAnyPos(int data,int pos){
    struct node* newNode=createNode(data); 
   if(pos==0){
    struct node* newNode=createNode(data);
    head=tail=newNode;
    printf("Node inserted at position %d !!\n",pos);
   }
   else{
    struct node* temp=head;
    int i=0;
    while(temp!=NULL){
        if(i==pos)
            break;
        temp=temp->next;
        i++;
    }
    if(temp==NULL && i != pos)
        printf("Invalid position!!\n");
    else if(i==pos){
        tail->next=newNode;
        newNode->prev=tail;
        tail=newNode;
        printf("Node inserted at position %s!!\n",pos);
        
    }
    else{
        temp->prev->next=newNode;
        newNode->prev=temp->prev;
        temp->prev=newNode;
        newNode->next=temp;
        printf("Node inserted at position %s!!\n",pos);
    }
   }

}

void deleteFromBeg(){
    if(head==NULL && tail==NULL)
    printf("List is empty!!\n");
    else if(head == tail){
        head=tail=NULL;
        printf("Node deleted from beginning!!\n");
    }
    else{
        //struct node* delNode=head;
        head=head->next;
        //free(delNode);
        printf("Node deleted from beginning!!\n");
    }
}

void deleteFromEnd(){
    if(head==NULL && tail==NULL)
    printf("List is empty!!\n");
    else if(head == tail){
        head=tail=NULL;
        printf("Node deleted from end!!\n");
    }
    else{
        tail->prev->next=NULL;
        tail=tail->prev;
        printf("Node deleted from end!!\n");
    }
}

void deleteFromAnypos(int pos){
    if(head==NULL && tail==NULL){
    printf("List is empty!!\n");
   }
   else if(pos==0){
    deleteFromBeg();
   }
   else{
        struct node* temp=head;
        int i=0;
        while(temp!=NULL && i!=pos){
            temp=temp->next;
            i++;
        }
        if(temp==NULL)
        printf("Invalid position!!\n");
        else{
            temp->prev->next=temp->next;
            if(temp->next != NULL)
                temp->next->prev=temp->prev;
            else
                tail=temp->prev;
            printf("Node deleted from position %d !!\n",pos);
        }
   }
}

void search(int value){
    if(head==NULL && tail==NULL){
    printf("List is empty!!\n");
   }
   else{
    struct node* temp=head;
    while(temp!=NULL){
        if(temp->data==value){
            printf("Found!!\n");
            return;
        }
        temp=temp->prev;
    }
   }
}

void display(){
    if(head==NULL && tail==NULL){
    printf("List is empty!!\n");
   }
   else{
    struct node* temp=head;
    while(temp!=NULL){
        if(temp!=NULL){
            printf("%d ",temp->data);
            temp=temp->next;
        }
    }
    printf("\n");
   }
}

