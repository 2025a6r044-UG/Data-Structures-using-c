// Binary search tree using array 
#include<stdio.h>
#include<stdlib.h>
#define MAX 100
int tree[MAX],idx=0;
void intitTree(){
    for(int i=0; i<MAX; i++){
        tree[i] = -1;

    }
}
void insert(int val){ // Here we are inserting data in BT using level order
    if(idx == MAX)   
       printf("Tree is full!!!\n");
       else{
        tree[idx++]= val;
       }
}
int search(int val){
    for(int i =0; i<idx; i++){
    if(tree[i]==val)
    return i;
    }
    return -1;
}
void delete(int val){
    int index = search(val);
    if(index == -1)
    printf("Element not found !!!\n");
    else{
        tree[index] = tree[--idx];
        printf("Node deleted !!!\n");
    }
}
void levelOrder(){
    if(idx == 0)
    printf("Tree is Empty!!!\n");
    else{
        for(int i=0; i<idx; i++){
            if(tree[i] != -1)
            printf("%d",tree[i]);
        }
    }
}
void preOrder(int index){
    if(index>= MAX || tree[index]==-1)
    return;
    printf("%d",tree[index]);
    preOrder(2*index+1);
    preOrder(2*index+2);

}
void inOrder(int index){
     if(index>= MAX || tree[index]==-1)
    return;
     inOrder(2*index+1);
     printf("%d",tree[index]);
    inOrder(2*index+2);

}
void postOrder(int index){
    if(index>= MAX || tree[index]==-1)
     return;
     postOrder(2*index+1);
     postOrder(2*index+2);
     printf("%d",tree[index]);
}
int main(){
    int choice,val;
    while(1){
        printf("\n***** Binary Tree Menu*****\n");
        printf("1.Insert\n");
        printf("2.Level Order Traversal\n");
        printf("3.Pre-Order Traversal\n");
        printf("4.In-Order Traversal\n");
        printf("5.Post-Order Traversal\n");
        printf("6. Search\n");
        printf("7. Delete\n");
        printf("8. Exit\n");
        printf("Enter choice:");
        scanf("%d",&choice);
        switch(choice){
            case1: 
            printf("Enter val:");
            scanf("%d",&val);
            insert(val);
            break;
            case2:
            levelOrder();
            break;
            case3:
            preOrder(0);
            break;
            case4:
            inOrder(0);
            break;
            case5:
             postOrder(0);
            break;
            case6:
            printf("Enter Element To Search:");
            scanf("%d", &val);
            if(search(val)==-1)
            printf("Not Found !!!\n");
            else
            printf("Found!!!\n");
            case 7:
            printf("Enter Element To Delete:");
            scanf("%d", &val);
            delete(val);
            break;
            case 8:
            exit(0);
           default:
           printf("Invalid choice!!!\n");


        }
    }
    return 0;
}
